<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ExtendedWhips</AssemblyName>
    <RootNamespace>ExtendedWhips</RootNamespace>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Construction Simulator</GameDir>
  </PropertyGroup>

  <!-- Local Core BepInEx Assemblies -->
  <ItemGroup Condition="Exists('$(GameDir)\BepInEx\core')">
    <Reference Include="$(GameDir)\BepInEx\core\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Interop assemblies generated by BepInEx Cpp2IL -->
  <ItemGroup Condition="Exists('$(GameDir)\BepInEx\interop')">
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
